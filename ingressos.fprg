    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idade" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite sua idade para comprar o ingresso: &quot;" newline="False"/>
            <input variable="idade"/>
            <if expression="idade &lt; 16">
                <then>
                    <output expression="&quot;ingresso voce pode apenas inteira.&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="idade &gt;= 16 and idade &lt;= 17">
                        <then>
                            <output expression="&quot;voce pode pegar apenas ingresso inteiro.&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="idade &lt;= 70">
                                <then>
                                    <output expression="&quot;Voce pode pegar apenas ingresso inteira.&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot; voc&#234; pode pegar ingresso meia e inteira.&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
