    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="esgotado, n, s" type="String" array="False" size=""/>
            <output expression="&quot;Ainda h&#225; estoque do produto? (Responda s/n)&quot;" newline="True"/>
            <input variable="esgotado"/>
            <if expression="esgotado = &quot;n&quot;">
                <then>
                    <output expression="&quot;Produto esgotado. Por favor, reabaste&#231;a o estoque&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Produto dispon&#237;vel para venda.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
