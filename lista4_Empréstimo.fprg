<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Dev_1o_Ano"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-14 01:23:26 "/>
        <attribute name="created" value="RGV2XzFvX0FubztETlMxMTgxMjYwODAyOzIwMjYtMDQtMTQ7IjExOjQwOjE4ICI7Mjg1MA=="/>
        <attribute name="edited" value="RGV2XzFvX0FubztETlMxMTgxMjYwODAyOzIwMjYtMDQtMTQ7IjAxOjIzOjI2ICI7MjsyOTU4"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="salario" type="Integer" array="False" size=""/>
            <declare name="s, n" type="String" array="False" size=""/>
            <output expression="&quot;Informe sua renda mensal: R$&quot;" newline="True"/>
            <input variable="salario"/>
            <if expression="salario &gt; 2000">
                <then>
                    <output expression="&quot;Voc&#234; possui fiador? (Responda s/n)&quot;" newline="True"/>
                    <input variable="s"/>
                    <if expression="s = &quot;s&quot;">
                        <then>
                            <output expression="&quot;Voc&#234; possui nome sujo no SERASA?&quot;" newline="True"/>
                            <input variable="s"/>
                            <if expression="s = &quot;n&quot;">
                                <then>
                                    <output expression="&quot;Seu pedido de empr&#233;stimo foi aprovado!&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Sua solicita&#231;&#227;o de empr&#233;stimo foi recusada.&quot;" newline="True"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <output expression="&quot;Sua solicita&#231;&#227;o de empr&#233;stimo foi negada.&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Sua solicita&#231;&#227;o de empr&#233;stimo foi negada.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
