    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota, frequencia" type="Real" array="False" size=""/>
            <output expression="&quot;Informe sua nota:&quot;" newline="True"/>
            <input variable="nota"/>
            <output expression="&quot;Informe sua frequ&#234;ncia&quot;" newline="True"/>
            <input variable="frequencia"/>
            <if expression="(nota &gt;= 7)and(frequencia &gt;= 0.75)">
                <then>
                    <output expression="&quot;Parab&#233;ns. Voc&#234; foi aprovado.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sentimos muito. Voc&#234; foi reprovado&quot;" newline="True"/>
                </else>
            </if>
        </body>
